  "actions": [
    {
      "date": "2025-09-08",
      "text": "UO announced $29.2 million a year of recurring E&G budget reductions for FY26, including $4.3 million of non-labor savings. They eliminated 176 positions: 117 filled and 59 vacant.",
      "source": {
        "url": "https://president.uoregon.edu/september-budget-reduction-information",
        "document": "September budget reduction information",
        "location": "web page",
        "retrievedOn": "2026-09-25"
      }
    },
    {
      "date": "2026-05-14",
      "text": "The president announced a hiring and pay action freeze and limits on non-essential travel; pay increases already committed for September went ahead. No savings estimate for the freeze has been published.",
      "source": {
        "url": "https://president.uoregon.edu/news-uo-budget-and-road-ahead",
        "document": "News on the UO budget and the road ahead",
        "location": "web page",
        "retrievedOn": "2026-09-25"
      }
    },
    {
      "date": "2026-06-02",
      "text": "The Board adopted the FY27 budget of $1,553,500,000 and required a budget reduction plan for the projected multi-year deficit, with a revised FY27 expenditure authorization, by December 15, 2026.",
      "source": {
        "url": "https://trustees.uoregon.edu/sites/default/files/2026-09/full-bot-packet-september-2026_0.pdf",
        "document": "Board of Trustees meeting materials, September 28-29, 2026",
        "location": "printed p. 16",
        "retrievedOn": "2026-09-25"
      }
    },
    {
      "date": "2026-07-20",
      "text": "Vice presidents and deans are modelling general fund reductions of 5%, 10%, and 15% across administrative and academic units, phased over one or more years. The message says these are not final decisions.",
      "source": {
        "url": "https://president.uoregon.edu/message-president-scholz-uo-budget-process",
