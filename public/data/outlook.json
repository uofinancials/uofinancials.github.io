      "assumptions": [
        {
          "text": "The projection leaves out any budget action still needed to close the deficit.",
          "location": "printed p. 33"
        },
        {
          "text": "Tuition for students starting from FY28 rises 4.0% a year for residents and 3.25% for nonresidents. These rates are illustrative; the Board sets tuition each spring.",
          "location": "printed pp. 33, 37"
        },
        {
          "text": "The guaranteed tuition program continues, so continuing undergraduates keep their rates.",
          "location": "printed p. 33"
        },
        {
          "text": "Incoming first-year classes stay at the Fall 2026 forecast: 2,641 resident, 1,888 nonresident, and 136 international students. Undergraduate headcount falls from 20,730 in FY26 to 19,207 in FY31.",
          "location": "printed pp. 34, 36"
        },
        {
          "text": "The state appropriation grows each year, to $139,071,512 in FY31.",
          "location": "printed pp. 34, 37"
        },
        {
          "text": "Indirect cost recovery (ICC) revenue dips in FY27 and then grows modestly.",
          "location": "printed p. 34"
        },
        {
          "text": "Pay follows the United Academics contract and the announced officer of administration salary programs, with 3% raises for groups without a settled contract and for the later years.",
          "location": "printed p. 35"
        },
        {
          "text": "Blended OPE rates rise sharply in FY27 with higher PERS rates, then level off.",
          "location": "printed p. 35"
        },
        {
          "text": "Supplies and services start from the FY26 forecast, adjusted for inflation and for some specific increases such as utilities and insurance.",
          "location": "printed p. 35"
        },
        {
          "text": "The FY26 budget reductions take full effect in FY27.",
          "location": "printed p. 35"
        }
